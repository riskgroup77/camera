# Production GPU image — InsightFace (onnxruntime-gpu) va YOLO (PyTorch) CUDA'da.
# Xostda: NVIDIA drayveri (CUDA 13 uchun >= 580) + nvidia-container-toolkit
# (deploy/install-nvidia-toolkit.sh). server-pull.sh bu image'ni
# deploy/docker-compose.gpu.yml orqali faqat `nvidia-smi` ishlasa quradi.
#
# Versiyalar nega shunday (2026-09-19 da tekshirildi):
#   * Python 3.14 — asosiy image bilan bir xil (python:3.14-slim).
#   * onnxruntime-gpu 1.28 PyPI'da CUDA 13.0 + cuDNN 9 bilan qurilgan
#     (1.27 dan beri standart). Eski cu124 torch bilan birga ishlamasdi,
#     cu124 indeksida esa Python 3.14 uchun torch g'ildiragi umuman yo'q —
#     shuning uchun avvalgi Dockerfile.gpu qurilmasdi.
#   * torch 2.13.0+cu130 (cp314 g'ildiragi bor) CUDA 13 runtime, cuBLAS,
#     cuFFT, cuRAND va cuDNN 9 ni pip'dagi nvidia-* paketlari sifatida olib
#     keladi. onnxruntime ularni preload_dlls() bilan o'sha yerdan yuklaydi
#     (app/services/face_recognition.py _preload_cuda_libraries) — alohida
#     CUDA toolkit o'rnatish shart emas.
# Qabul mezoni: /api/system/ai-status -> gpu.faceGpuActive = true va
# faceSessionProviders ichida CUDAExecutionProvider.

FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ARG TORCH_INDEX=https://download.pytorch.org/whl/cu130
ARG TORCH_VERSION=2.13.0+cu130
ARG TORCHVISION_VERSION=0.28.0+cu130

# CUDA torch ultralytics'dan OLDIN — aks holda pip PyPI'dagi torch'ni oladi.
RUN pip install --no-cache-dir --index-url "${TORCH_INDEX}" \
    "torch==${TORCH_VERSION}" "torchvision==${TORCHVISION_VERSION}"

# GPU ro'yxati asosiy requirements.txt dan hosil qilinadi (alohida fayl
# eskirib qolardi — requirements-gpu.txt'da openpyxl yo'q edi): faqat
# onnxruntime -> onnxruntime-gpu. Constraint torch'ni CUDA versiyasida ushlaydi.
COPY requirements.txt requirements.cpu.txt
RUN sed 's/^onnxruntime==/onnxruntime-gpu==/' requirements.cpu.txt > requirements.txt \
    && printf 'torch==%s\ntorchvision==%s\n' "${TORCH_VERSION}" "${TORCHVISION_VERSION}" > constraints.txt \
    && pip install --no-cache-dir --extra-index-url "${TORCH_INDEX}" -c constraints.txt -r requirements.txt
# Biror paket CPU `onnxruntime` ni ham tortib kelgan bo'lsa, ikkalasi bitta
# `onnxruntime` modul papkasiga yozadi. CPU paketi olib tashlanadi va GPU
# paketi fayllari qayta yoziladi (uninstall umumiy fayllarni ham o'chiradi).
RUN if pip show onnxruntime >/dev/null 2>&1; then \
        pip uninstall -y onnxruntime \
        && pip install --no-cache-dir --force-reinstall --no-deps \
           "$(grep '^onnxruntime-gpu==' requirements.txt)"; \
    fi

# Qurish paytida tekshiruv (GPU'siz ham ishlaydi): CUDA provayderi va CUDA
# torch haqiqatan o'rnatilgan. Aks holda image jimgina CPU'da ishlardi.
RUN python -c "import onnxruntime as o, torch; \
p = o.get_available_providers(); assert 'CUDAExecutionProvider' in p, p; \
assert (torch.version.cuda or '').startswith('13'), torch.version.cuda; \
print('onnxruntime', o.__version__, p, '| torch', torch.__version__, 'CUDA', torch.version.cuda)"

COPY . .

RUN useradd --create-home appuser \
    && mkdir -p /home/appuser/.insightface/models \
    && chown -R appuser:appuser /app /home/appuser/.insightface
USER appuser

VOLUME /home/appuser/.insightface

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health').read()" || exit 1

ENV WEB_CONCURRENCY=1
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8080 --workers ${WEB_CONCURRENCY}"]
