# Nusxa oling: cp .env.example .env
#
# Production (300+ kamera, 10k+ talaba): deploy/env.production.scale faylini
# serverdagi camera-api/.env ga merge qiling — scripts/apply_production_env.py
# yoki deploy_now.py avtomatik qiladi. Maxfiy kalitlar (DB_PASSWORD, JWT_SECRET,
# ENCRYPTION_KEY, S3_*) shu faylda EMAS — ular server .env da allaqachon bo'lishi kerak.

PORT=8080
DATABASE_URL=postgresql+asyncpg://camera_api:camera_api_dev_pw@127.0.0.1:5432/camera_api
# docker-compose.yml faqat shu qiymatdan (DB_PASSWORD) postgres konteyneri
# uchun parol va api konteyneri uchun to'liq DATABASE_URL quradi — yuqoridagi
# DATABASE_URL qatori faqat Docker'siz local ishga tushirish uchun.
DB_PASSWORD=camera_api_dev_pw
# Raise these on a production server with many cameras — 14 background AI
# sweep loops each open their own per-camera DB sessions on top of normal
# admin-panel traffic; SQLAlchemy's own defaults (5/10) are too small.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT_SECONDS=30
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=12
CORS_ORIGIN=http://localhost:5173
# docker-compose.yml/Dockerfile only — number of uvicorn worker processes.
# Not read by the app itself (pydantic-settings ignores unknown env vars).
WEB_CONCURRENCY=1

# Kamera RTSP login/parolini bazada shifrlash uchun kalit — generatsiya qilish:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# S3-mos fayl saqlash (MinIO local dev'da, production'da haqiqiy S3/MinIO klasteri)
S3_ENDPOINT_URL=http://127.0.0.1:9000
# Faqat presigned URL imzolash uchun ishlatiladi (brauzer shu manzilga
# ulanadi) — Docker Compose'da S3_ENDPOINT_URL="http://minio:9000" (konteyner
# ichki nomi) bo'lsa, buni brauzer ko'ra oladigan manzilga o'rnating, masalan
# "http://localhost:9000". Bo'sh qoldirilsa S3_ENDPOINT_URL bilan bir xil
# deb hisoblanadi (oddiy local dev holati uchun yetarli).
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=camera-uploads
S3_REGION=us-east-1

# RTSP->WebRTC/HLS gateway (MediaMTX). API_URL is the control API used to
# register/unregister camera streams; HLS_BASE_URL is what LiveVideoPlayer.tsx
# on the frontend actually plays.
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_HLS_BASE_URL=http://127.0.0.1:8888
# Docker/production: browser-facing HLS URL (above) often differs from what
# the API container reaches internally — set this so frame_grabber rewrites
# public stream URLs before ffmpeg opens them. Compose default:
# MEDIAMTX_HLS_INTERNAL_BASE_URL=http://mediamtx:8888
MEDIAMTX_HLS_INTERNAL_BASE_URL=

# AI loop stagger at startup — seconds between each loop's first tick
# (app/main.py). Default 2.0 spreads 16 loops over ~30s.
AI_LOOP_STAGGER_SECONDS=2.0

# Kamera "haqiqatan ulanganmi" tekshiruvi (app/jobs/camera_health.py) — har
# necha soniyada, va muvaffaqiyatli tekshiruv necha soniya "yangi" hisoblanadi.
CAMERA_HEALTH_INTERVAL_SECONDS=30
CAMERA_HEALTH_FRESHNESS_SECONDS=90
# Necha daqiqa "javob yo'q" bo'lsa admin alert (AuditLog + WARNING log)
CAMERA_OFFLINE_ALERT_MINUTES=5

# Yuzni tanish orqali avtomatik davomat (app/jobs/attendance_ai.py) — tashqi
# AI xizmatga ulanmaydi, faqat mahalliy InsightFace modelidan foydalanadi.
ATTENDANCE_AI_INTERVAL_SECONDS=30
ATTENDANCE_AI_MATCH_THRESHOLD=0.55
ATTENDANCE_AI_LATE_CUTOFF=09:00

# Ko'p kamera/ko'p odam masshtabi (400+ kamera, 10,000+ odam) — production
# GPU serverida oshiring, dev mashinada default qoldiring:
#   AI_SWEEP_CAMERA_CONCURRENCY — har bir sweep tsikli bir vaqtda nechta
#     kamerani ishlaydi (ffmpeg o'qish + aniqlash + DB yozish). Dev uchun 8,
#     kuchli production serverda 32-64 atrofida sinab ko'ring.
#   FACE_RECOGNITION_GPU_ENABLED — true qilinsa InsightFace CUDA orqali
#     ishlaydi (onnxruntime-gpu paketi o'rnatilgan bo'lishi kerak — pastdagi
#     izohga qarang). Aks holda CPU'ga avtomatik qaytadi.
#   FACE_RECOGNITION_INFERENCE_CONCURRENCY — bir vaqtda nechta InsightFace
#     chaqiruvi ishlaydi. CPU uchun 2, GPU uchun serverning haqiqiy
#     o'lchovlariga qarab ancha yuqoriroq (masalan 16-32) qo'ying.
#   OBJECT_DETECTION_INFERENCE_CONCURRENCY — YOLO (telefon/transport) uchun.
#   POSE_DETECTION_INFERENCE_CONCURRENCY — mediapipe Pose uchun.
AI_SWEEP_CAMERA_CONCURRENCY=8
FACE_RECOGNITION_GPU_ENABLED=false
FACE_RECOGNITION_INFERENCE_CONCURRENCY=2
OBJECT_DETECTION_INFERENCE_CONCURRENCY=2
POSE_DETECTION_INFERENCE_CONCURRENCY=2

# Doimiy kamera kadr keshi (app/services/stream_cache.py) — har bir grab
# uchun yangi ffmpeg jarayoni ishga tushirish o'rniga, har bir kamera uchun
# uzoq muddatli o'qish jarayoni ishlaydi va faqat oxirgi kadrni xotirada
# saqlaydi.
STREAM_CACHE_MAX_AGE_SECONDS=15
STREAM_CACHE_IDLE_TIMEOUT_SECONDS=300
STREAM_CACHE_CAPTURE_FPS=2

# AI-detected incidents retention (app/jobs/cleanup.py)
EVENT_RETENTION_DAYS=180

# Unified face sweep — bitta tick da davomat/begona/olomon/uxlab qolish
# (app/jobs/unified_face_sweep.py). false qilsangiz 4 ta alohida loop ishlaydi.
UNIFIED_FACE_SWEEP_ENABLED=true
UNIFIED_FACE_SWEEP_INTERVAL_SECONDS=30

# Redis (optional) — multi-worker rate limits + WebSocket pub/sub.
# Docker Compose default: redis://redis:6379/0
REDIS_URL=

# Central AI scheduler — true = one coordinator instead of 16 independent loops.
AI_SCHEDULER_ENABLED=false
AI_SCHEDULER_POLL_SECONDS=5

# GPU batch inference chunk sizes (app/services/face_recognition.py, object_detection.py)
FACE_RECOGNITION_BATCH_SIZE=4
OBJECT_DETECTION_BATCH_SIZE=4

# FAISS face index when enrolled count >= threshold (requires faiss-cpu).
FACE_MATCH_FAISS_MIN_SIZE=10000

# MediaMTX sharding (optional) — comma-separated equal-length lists:
# MEDIAMTX_SHARD_API_URLS=http://mediamtx-0:9997,http://mediamtx-1:9997
# MEDIAMTX_SHARD_HLS_BASE_URLS=http://stream1.example:8888,http://stream2.example:8888

# Parolni tiklash havolasi shu manzil ostida quriladi.
FRONTEND_BASE_URL=http://localhost:5173

# SMTP bo'sh qoldirilsa (dev holati), parolni tiklash havolasi email o'rniga
# server logiga strukturaviy yoziladi — funksionallik ishlaydi, faqat
# yetkazish kanali email emas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@fjsti.local
SMTP_USE_TLS=true
