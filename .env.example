# Backend API integratsiyasi uchun muhit o'zgaruvchilari.
# Nusxa oling: cp .env.example .env.local
# Vite'da faqat VITE_ prefiksli o'zgaruvchilar brauzer kodiga ochiladi.

# Backend REST API manzili (masalan https://api.fjsti.uz/v1)
VITE_API_BASE_URL=

# Real vaqtli hodisalar uchun WebSocket/SSE manzili (masalan wss://api.fjsti.uz/ws)
VITE_REALTIME_URL=

# Kamera video oqimi gateway manzili (WebRTC/HLS transkodlash serveri)
VITE_STREAM_GATEWAY_URL=
