[Unit]
Description=Camera API Docker Compose stack
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/camera/camera-api
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.mediamtx.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.mediamtx.yml down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
