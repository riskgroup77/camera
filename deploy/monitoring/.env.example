# Monitoring steki sozlamalari. Nusxa oling va to'ldiring (fayl gitignore'da):
#   cp deploy/monitoring/.env.example deploy/monitoring/.env && chmod 600 deploy/monitoring/.env
# Haqiqiy tokenlarni HECH QACHON repoga yozmang.

# Grafana administratori (birinchi ishga tushishda yaratiladi; keyin parolni
# Grafana ichida almashtirsangiz, bu qiymat e'tiborsiz qoladi).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Grafana tashqi manzili (nginx orqali). Subdomen:
GRAFANA_ROOT_URL=https://monitor.cam.fermi.uz/
GRAFANA_SERVE_FROM_SUB_PATH=false
# Subpath varianti (deploy/monitoring/nginx/grafana-subpath.conf):
#   GRAFANA_ROOT_URL=https://cam.fermi.uz/grafana/
#   GRAFANA_SERVE_FROM_SUB_PATH=true
# HTTPS orqali ochilsa true (faqat SSH tunnel orqali ishlatilsa false).
GRAFANA_COOKIE_SECURE=true

# Telegram ogohlantirishlari (Alertmanager). Bot: @BotFather -> /newbot.
# Chat ID: botni guruhga qo'shing, guruhga xabar yozing va
#   curl -s https://api.telegram.org/bot<TOKEN>/getUpdates
# javobidagi "chat":{"id":-100...} ni oling. Ikkalasi bo'sh — yuborilmaydi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Guruhdagi mavzu (topic) — ixtiyoriy.
TELEGRAM_MESSAGE_THREAD_ID=
# Hal bo'lmagan ogohlantirish qayta yuboriladigan oraliq (critical — har 1 soat).
ALERT_REPEAT_INTERVAL=4h
# Alertmanager havolalari xabarlarda (ixtiyoriy).
ALERTMANAGER_EXTERNAL_URL=http://127.0.0.1:19093

# Prometheus ma'lumotlari qancha saqlanadi (qaysi biri avval yetsa).
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=20GB
