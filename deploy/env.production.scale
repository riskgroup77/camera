# Production scale profile — 300+ cameras, 10,000+ enrolled students.
# Applied to camera-api/.env on the server (secrets stay untouched).
# Merge: scripts/apply_production_env.py or deploy_now.py

# ── Web / workers ──────────────────────────────────────────────────────────
WEB_CONCURRENCY=2
CORS_ORIGIN=https://cam.fermi.uz
FRONTEND_BASE_URL=https://cam.fermi.uz

# ── Database pool (many AI sweeps + admin traffic) ─────────────────────────
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=60
DB_POOL_TIMEOUT_SECONDS=45

# ── Redis (multi-worker rate limits + WebSocket fan-out) ───────────────────
REDIS_URL=redis://redis:6379/0

# ── MediaMTX / streaming (3-shard on one host via nginx /s0 /s1 /s2) ───────
MEDIAMTX_HLS_BASE_URL=https://stream.cam.fermi.uz
MEDIAMTX_HLS_INTERNAL_BASE_URL=http://mediamtx-0:8888
# MediaMTX horizontal sharding — path-based on stream.cam.fermi.uz (/s0 /s1 /s2)
MEDIAMTX_SHARD_API_URLS=http://mediamtx-0:9997,http://mediamtx-1:9997,http://mediamtx-2:9997
MEDIAMTX_SHARD_HLS_BASE_URLS=https://stream.cam.fermi.uz/s0,https://stream.cam.fermi.uz/s1,https://stream.cam.fermi.uz/s2
MEDIAMTX_SHARD_HLS_INTERNAL_BASE_URLS=http://mediamtx-0:8888,http://mediamtx-1:8888,http://mediamtx-2:8888

# ── AI orchestration ───────────────────────────────────────────────────────
AI_SCHEDULER_ENABLED=true
AI_SCHEDULER_POLL_SECONDS=5
AI_LOOP_STAGGER_SECONDS=2.0
UNIFIED_FACE_SWEEP_ENABLED=true
UNIFIED_FACE_SWEEP_INTERVAL_SECONDS=30

# Parallel cameras per sweep wave (ffmpeg + DB + inference pipeline)
AI_SWEEP_CAMERA_CONCURRENCY=24

# ── Inference gates (GPU server — falls back to CPU if CUDA unavailable) ─
FACE_RECOGNITION_GPU_ENABLED=true
FACE_RECOGNITION_INFERENCE_CONCURRENCY=24
FACE_RECOGNITION_BATCH_SIZE=8

OBJECT_DETECTION_GPU_ENABLED=true
OBJECT_DETECTION_INFERENCE_CONCURRENCY=8
OBJECT_DETECTION_BATCH_SIZE=8

POSE_DETECTION_INFERENCE_CONCURRENCY=6
POSE_DETECTION_MAX_POSES=5

# ── Stream cache (lower fps = less CPU/RAM with 300 ffmpeg readers) ────────
STREAM_CACHE_CAPTURE_FPS=1.0
STREAM_CACHE_MAX_AGE_SECONDS=15
STREAM_CACHE_IDLE_TIMEOUT_SECONDS=300

# ── Face matching at 10k+ scale ─────────────────────────────────────────────
FACE_MATCH_FAISS_MIN_SIZE=10000
ATTENDANCE_AI_MATCH_THRESHOLD=0.55

# ── Retention ───────────────────────────────────────────────────────────────
EVENT_RETENTION_DAYS=180
AUDIT_LOG_RETENTION_DAYS=90

# ── Camera health ───────────────────────────────────────────────────────────
CAMERA_HEALTH_INTERVAL_SECONDS=30
CAMERA_HEALTH_FRESHNESS_SECONDS=120
CAMERA_OFFLINE_ALERT_MINUTES=5

# ── Module intervals: critical 30s, standard 45s, heuristic 60s ───────────
# Critical (attendance path uses unified_face_sweep at 30s above)
FALL_AI_INTERVAL_SECONDS=30
ZONE_AI_INTERVAL_SECONDS=30
UNAUTHORIZED_PERSON_AI_INTERVAL_SECONDS=30
CROWD_AI_INTERVAL_SECONDS=30

FIRE_AI_INTERVAL_SECONDS=45
PHONE_AI_INTERVAL_SECONDS=45
VEHICLE_AI_INTERVAL_SECONDS=45
DISORDER_AI_INTERVAL_SECONDS=45
LESSON_QUALITY_AI_INTERVAL_SECONDS=45
TEACHER_PUNCTUALITY_INTERVAL_SECONDS=60

FIGHT_AI_INTERVAL_SECONDS=60
ABANDONED_OBJECT_AI_INTERVAL_SECONDS=60
BADGE_AI_INTERVAL_SECONDS=60
COAT_AI_INTERVAL_SECONDS=60
PPE_AI_INTERVAL_SECONDS=60
SMOKING_AI_INTERVAL_SECONDS=60
STUDENT_UNIFORM_AI_INTERVAL_SECONDS=60
